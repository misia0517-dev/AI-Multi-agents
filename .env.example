OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# LangSmith (optional — set LANGCHAIN_TRACING_V2=true to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=MSBA_AI_Agents_Demo
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Embedded evals (optional — set RUN_EVALS=true to score a completed run)
RUN_EVALS=false
ANTHROPIC_MODEL=claude-sonnet-4-6

# Weather (Open-Meteo, no key needed — but location is configurable)
WEATHER_LAT="40.7282"
WEATHER_LON="-74.0776"
WEATHER_TZ="America/New_York"

# Email (optional — leave blank to skip)
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
# Zoho example:
#   SMTP_HOST=smtp.zoho.com
#   SMTP_PORT=465
REPORT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
